# ============================================
# REQUIRED: GitHub access (for PR review)
# ============================================
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx
# Get from: https://github.com/settings/tokens

# ============================================
# MODELS: Add keys for whichever you want to use
# (at least one required)
# ============================================

# Claude (Anthropic cloud)
ANTHROPIC_API_KEY=sk-ant-api03-xxxxx
# Get from: https://console.anthropic.com/

# Gemini (Google cloud)
GOOGLE_API_KEY=AIzaSyxxxxx
# Get from: https://makersuite.google.com/app/apikey

# Mistral (if you add it later)
MISTRAL_API_KEY=xxxxx
# Get from: https://console.mistral.ai/

# ============================================
# OLLAMA: Local models (no API key needed)
# ============================================
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2          # or: mistral, codellama, etc.

# ============================================
# SETTINGS: Which models to actually use
# ============================================
COUNCIL_MODELS=claude,gemini   # ← Change this line!

# Examples:
# COUNCIL_MODELS=claude                    # Just Claude
# COUNCIL_MODELS=claude,gemini             # Claude + Gemini
# COUNCIL_MODELS=claude,gemini,ollama      # All three
# COUNCIL_MODELS=ollama                    # Just local Ollama

APPROVAL_THRESHOLD=0.7         # Score needed to approve (0.0-1.0)