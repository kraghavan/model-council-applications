# Model Council Configuration
# Copy to .env and fill in your values

# =============================================================================
# GitHub (required for pr-review task)
# =============================================================================
GITHUB_TOKEN=

# =============================================================================
# Model API Keys (at least one required)
# =============================================================================

# Anthropic Claude - https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Google Gemini - https://aistudio.google.com/
GOOGLE_API_KEY=

# Mistral AI - https://console.mistral.ai/
MISTRAL_API_KEY=

# OpenAI - https://platform.openai.com/
OPENAI_API_KEY=

# DeepSeek - https://platform.deepseek.com/
DEEPSEEK_API_KEY=

# Groq (free tier!) - https://console.groq.com/
GROQ_API_KEY=

# =============================================================================
# Ollama (optional - local models, no API key needed)
# =============================================================================
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2

# =============================================================================
# Model Versions (defaults shown)
# =============================================================================
CLAUDE_MODEL=claude-sonnet-4-20250514
GEMINI_MODEL=gemini-1.5-pro
MISTRAL_MODEL=mistral-large-latest
OPENAI_MODEL=gpt-4o
DEEPSEEK_MODEL=deepseek-chat
GROQ_MODEL=llama-3.3-70b-versatile

# =============================================================================
# Council Settings
# =============================================================================

# Which models to use (comma-separated)
# Options: claude, gemini, mistral, openai, deepseek, groq, ollama
COUNCIL_MODELS=claude,gemini

# Score threshold for approval (0.0-1.0)
APPROVAL_THRESHOLD=0.7